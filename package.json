{
  "name": "flaschen-taschen-node",
  "version": "0.1.0",
  "description": "A simple to use library for constructing PPM images and transmitting images over UDP to Flaschen Taschen RGB matrix servers",
  "type": "module",
  "repository": "https://github.com/telekineticyeti/flaschen-taschen-node",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "unbuild",
    "build:dev": "unbuild --stub",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tslib": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "unbuild": "^1.0.1",
    "vitest": "^5.0.5"
  }
}
